# Database (Sequelize connection)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_tracker
DB_USER=postgres
DB_PASSWORD=your_password_here

# Set to true when the database requires TLS (Neon, Render Postgres, Supabase)
DB_SSL=false

# Express listen port
PORT=3001

# Public URL of the frontend — used in password-reset email links.
# Set to your deployed frontend URL in production.
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed browser origins (CORS). Leave unset for
# local development; set to your deployed frontend URL in production.
CORS_ORIGIN=

# JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production — the server refuses to boot without it there.
JWT_SECRET=replace_with_a_long_random_secret

# Rate limits (requests per 15 minutes per IP). Defaults shown.
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Password-reset mail (nodemailer SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_password

# Cloudinary avatar uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
